# ============================================================
# Rips Society store server — configuration
# Copy this file to `.env` and fill in real values.
# NEVER commit the real .env file (it's in .gitignore).
# ============================================================

# Port the server listens on (hosting providers usually set this for you)
PORT=3000

# Public URL of the site, used in Stripe redirect links.
# Example: https://shop.ripssociety.com  (no trailing slash)
BASE_URL=http://localhost:3000

# ---------- STRIPE (card payments) ----------
# Get keys at https://dashboard.stripe.com/apikeys
#   sk_test_...  = test mode (use card 4242 4242 4242 4242 to test)
#   sk_live_...  = real charges
# Leave blank to run the store in test mode with no card charged.
STRIPE_SECRET_KEY=

# From https://dashboard.stripe.com/webhooks — add endpoint:
#   POST {BASE_URL}/api/stripe/webhook   event: checkout.session.completed
# Optional but recommended for production.
STRIPE_WEBHOOK_SECRET=

# ---------- EMAIL (order confirmations + contact form) ----------
# Works with any SMTP provider. Easiest with Gmail:
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=<app password from https://myaccount.google.com/apppasswords>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Rips Society <orders@ripssociety.com>"

# Where YOU get notified about new orders and contact messages
SHOP_NOTIFY_EMAIL=

# ---------- TWILIO (text message confirmations) ----------
# Sign up at https://www.twilio.com — you get a trial number free.
# Leave blank to skip SMS (email still sends).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ---------- ADMIN ----------
# Any long random string. Then view orders with:
#   curl -H "Authorization: Bearer <token>" {BASE_URL}/api/admin/orders
ADMIN_TOKEN=
